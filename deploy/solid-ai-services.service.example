[Unit]
Description=SolidOS AI services
After=network.target

[Service]
Type=simple
User=solidos
WorkingDirectory=/opt/solid-ai-services
EnvironmentFile=/opt/solid-ai-services/.env
ExecStart=/usr/bin/pnpm start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
