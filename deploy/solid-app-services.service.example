[Unit]
Description=SolidOS application services
After=network.target

[Service]
Type=simple
User=solidos
WorkingDirectory=/opt/solid-app-services
EnvironmentFile=/opt/solid-app-services/.env
ExecStart=/usr/bin/pnpm start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
