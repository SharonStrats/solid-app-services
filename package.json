{
  "name": "@solidos/solid-app-services",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAI services and MCP tools for SolidOS integrations",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
