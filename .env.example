HOST=127.0.0.1
PORT=5000
SOLID_AUTH_ISSUER=https://sharonsolidosplayground.com/
PUBLIC_API_ORIGIN=https://quiz.sharonsolidosplayground.com
SECURITY_DATABASE_PATH=./data/security.sqlite
# Daily request quotas reset at midnight in this IANA time zone.
# Defaults to the server's local time zone if unset.
# QUOTA_TIME_ZONE=Australia/Melbourne
# For local HTTP-only development, use localhost origins and set this to true.
# ALLOW_INSECURE_LOCAL_ORIGINS=true
REALTIME_TICKET_SECRET=replace-with-a-random-32-byte-secret
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Comma-separated browser origins. Use the exact HTTPS quiz origin in production.
CORS_ORIGINS=https://quiz.sharontest.com,http://localhost:4200
# Set these to the current OpenAI model prices per 1M tokens to estimate usage.
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0
# Required to access GET /metrics/usage.
USAGE_METRICS_TOKEN=
# Questionnaire access-request email (required to enable the endpoint).
RESEND_API_KEY=
ACCESS_REQUEST_EMAIL_TO=
ACCESS_REQUEST_EMAIL_FROM=
